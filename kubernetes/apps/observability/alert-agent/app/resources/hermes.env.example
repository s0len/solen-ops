# Non-secret environment for the Hermes container. The two SECRET keys below are
# NOT in this file; #9 injects them from Kubernetes Secrets. Prefer container env
# (envFrom) over writing $HERMES_HOME/.env: Hermes loads that file with
# override=True, so a stale key there silently wins over the Secret, and stage2
# needs the file writable to persist its generated API_SERVER_KEY.

# --- From Kubernetes Secrets (#9), never committed -------------------------
# HERMES_WEBHOOK_SECRET   Secret alert-agent-webhook-secret (External Secrets
#                         password generator). hermes-config.yaml reads it as
#                         platforms.webhook.extra.routes.investigate.secret via
#                         "${HERMES_WEBHOOK_SECRET}". The Gate signs with the
#                         same value under its own HERMES_WEBHOOK_SECRET.
# GITHUB_TOKEN            Secret alert-agent-github-secret. Used by `gh` in the
#                         Investigation and Fix runs. Also a credential for
#                         Hermes' `copilot` provider — harmless only because
#                         model.provider is pinned to openai-codex.

# --- Baked into the image, listed so a change is noticed -------------------
HERMES_HOME=/opt/data
HERMES_WRITE_SAFE_ROOT=/opt/data

# --- Set by the pod --------------------------------------------------------
TZ=Europe/Stockholm
# Cron ticks and the daily heartbeat/prune schedules follow this zone.

# Keeps the api_server listener DOWN. It is not a credential: the adapter
# refuses any key under 16 characters, and gateway/config_env.py::_api_server
# enables the platform from this variable AFTER config.yaml is read, so
# `platforms.api_server.enabled: false` cannot switch it off. Setting it here
# also stops the image's stage2 hook generating a real one into
# $HERMES_HOME/.env, which would enable a second control surface on 127.0.0.1
# with its key in plaintext next to the OpenAI credential.
API_SERVER_KEY=disabled

# --- Deliberately unset ----------------------------------------------------
# HERMES_MAX_ITERATIONS   agent.max_turns in hermes-config.yaml owns the cap;
#                         setting this here would shadow a config change.
# HERMES_REDACT_SECRETS   security.redact_secrets in hermes-config.yaml is
#                         bridged into it at startup.
# HERMES_YOLO_MODE        would bypass approvals; never set.
# OPENAI_API_KEY          the seat is authenticated by device-code OAuth into
#                         $HERMES_HOME/auth.json, not by an API key.
