{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  platformAutomerge: false,
  automergeSchedule: ["* 7-21 * * *"],
  minimumReleaseAgeBehaviour: "timestamp-optional",
  packageRules: [
    {
      description: ["Auto-merge minor, patch and digest updates through a PR once CI is green"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: ["Let dated minor and patch releases age before they merge"],
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
    },
    {
      description: ["Majors wait for the weekly manual review"],
      matchUpdateTypes: ["major"],
      schedule: ["* * * * 6"],
    },
    {
      description: ["Never auto-merge what a rollback cannot undo or what takes the whole cluster down (ADR-0005)"],
      matchFileNames: [
        ".talos.env",
        "talos/**",
        "kubernetes/apps/cert-manager/**",
        "kubernetes/apps/database/cloudnative-pg/**",
        "kubernetes/apps/default/nextcloud/**",
        "kubernetes/apps/default/photos-backup/**",
        "kubernetes/apps/external-secrets/**",
        "kubernetes/apps/flux-system/flux-instance/**",
        "kubernetes/apps/flux-system/flux-operator/**",
        "kubernetes/apps/kopiur-system/**",
        "kubernetes/apps/kube-system/cilium/**",
        "kubernetes/apps/kube-system/coredns/**",
        "kubernetes/apps/media/qbittorrent/**",
        "kubernetes/apps/network/envoy-gateway/**",
        "kubernetes/apps/network/external-dns/**",
        "kubernetes/apps/openebs-system/**",
        "kubernetes/apps/rook-ceph/**",
        "kubernetes/apps/security/kanidm/**",
        "kubernetes/apps/volsync-system/**",
      ],
      automerge: false,
      schedule: ["* * * * 6"],
    },
    {
      description: ["Never auto-merge Talos, Kubernetes or the cluster-wide CRD releases, wherever they are pinned (ADR-0005)"],
      matchPackageNames: ["/siderolabs/", "/talos(ctl)?$/", "kubernetes-sigs/gateway-api", "kubernetes-sigs/external-dns"],
      automerge: false,
      schedule: ["* * * * 6"],
    },
  ],
}
